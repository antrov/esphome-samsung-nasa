{
  "name": "ESPHome CLI (samsung_nasa)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Linux hosts: host networking lets mDNS names (samsung_hvac.local) resolve for OTA.
  // On Docker Desktop (macOS/Windows) host networking is not available: remove "--network=host"
  // and use the device IP address with --device.
  "runArgs": ["--network=host"],
  // Keeps the PlatformIO toolchains between rebuilds, so only the first compilation downloads them.
  "mounts": [
    "source=esphome-samsung-nasa-platformio,target=/home/vscode/.platformio,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "esphome.esphome-vscode"],
      "settings": {
        "files.associations": { "samsung_hvac.yaml": "esphome" }
      }
    }
  }
}
